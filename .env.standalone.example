# =============================================================================
# Standalone Tutorial Studio — single-tenant environment template
# Copy to `.env` on the VPS and fill in. NOTHING here points at Konrad's infra.
#
# NOTE: Provider API keys can ALSO be entered in the app UI (Settings →
# Credentials), which stores them AES-GCM-encrypted in the `encrypted_secrets`
# table. Anything set there overrides the env value. So for the friend, only the
# CORE block below is strictly required in this file; provider keys are optional
# here and best entered via the UI.
# =============================================================================

# ---- CORE (required) --------------------------------------------------------
NODE_ENV=production
PORT=3000
BIND_HOST=0.0.0.0
DATABASE_URL=postgres://tutorial:CHANGE_ME@127.0.0.1:5432/tutorial_studio
REDIS_URL=redis://127.0.0.1:6379
# 32+ char random secret for signing session JWTs:
JWT_SECRET=CHANGE_ME_openssl_rand_hex_32
# 32-byte base64 key for encrypting stored provider secrets (openssl rand -base64 32):
SECRETS_ENCRYPTION_KEY=CHANGE_ME_base64_32_bytes
# Where rendered media + working files live on disk:
LOCAL_MEDIA_ROOT=/opt/tutorial-studio/media
THUMBNAIL_MEDIA_DIR=/opt/tutorial-studio/media/thumbnails
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# ---- LLM SCRIPT GENERATION (pick ONE provider; friend's own key) ------------
# Default tutorial script provider. Options: deepseek | google_gemini | anthropic
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
# If using Gemini instead:
GEMINI_FALLBACK_API_KEY=
GEMINI_API_KEY=
GEMINI_DIRECT_MODEL=gemini-2.0-flash
# If using Claude instead:
ANTHROPIC_API_KEY=

# ---- TTS (Fish Audio primary; friend's own key) -----------------------------
FISH_API_KEY=
FISH_API_BASE=https://api.fish.audio
# Leave FISH_TTS_MODEL UNSET. Tutorials always use the free `s2.1-pro-free`
# tier (hardcoded in tts-registry) with automatic failover to paid s2.1-pro on
# stall. Setting this only changes the global TTS gateway path; do NOT set it to
# a legacy/paid model (e.g. speech-1.6) — that disables the free→paid failover.
# FISH_TTS_MODEL=
TUTORIAL_FISH_VOICE=
TTS_MAX_CONCURRENT=2
# Optional TTS fallbacks:
ELEVENLABS_API_KEY=
MINIMAX_API_KEY=
INWORLD_API_KEY=
GOOGLE_TTS_API_KEY=

# ---- THUMBNAIL IMAGE GENERATION (external backend only for standalone) -------
# Self-hosted backends (veo_fleet/vup/forge) are NOT available standalone.
THUMBNAIL_BACKEND=ai33
AI33_API_KEY=
# Alternative: FASTGEN_API_URL= / FASTGEN_API_KEY=

# ---- GOOGLE DRIVE DELIVERY (friend's own Google project + account) ----------
STORAGE_DRIVE_ENABLED=false
# One-time consent via scripts/drive-authorize.mjs writes the refresh token file:
GOOGLE_OAUTH_CLIENT_SECRET_FILE=/opt/tutorial-studio/secrets/google-oauth-client.json
GOOGLE_DRIVE_REFRESH_TOKEN_FILE=/opt/tutorial-studio/secrets/google-drive-refresh-token.json
GOOGLE_OAUTH_CONSENT_STATUS=pending
STORAGE_DRIVE_CHUNK_BYTES=8388608
STORAGE_DRIVE_RPS=4
STORAGE_DRIVE_BURST=8

# ---- KEYWORD TOOL (optional; the friend's OWN Keyword Tool instance) --------
# Leave blank until his Keyword Tool is deployed on his VPS.
KT_EMBED_URL=
KT_EMBED_SECRET=
