{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    "composite": true,
    // DOM is here only for the WHATWG fetch types (Response, Headers,
    // BodyInit). This package runs on Node - there is no browser code in it.
    "lib": ["ES2022", "DOM"],
    "types": ["node"]
  },
  "include": ["src/**/*"],
  "exclude": [
    "node_modules",
    "dist",
    "src/**/*.test.ts",
    "src/**/__tests__/**"
  ],
  "references": [{ "path": "../db" }, { "path": "../logger" }]
}
