{
  "name": "@repo/storage",
  "version": "0.1.0",
  "private": true,
  "description": "Finished-product storage: VPS (primary) + Google Drive (secondary, resumable, quota-aware)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc --build",
    "dev": "tsc --build --watch",
    "lint": "echo 'storage lint not yet implemented'",
    "test": "vitest run --passWithNoTests",
    "test:coverage": "vitest run --coverage",
    "clean": "rimraf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@repo/db": "workspace:*",
    "@repo/logger": "workspace:*",
    "drizzle-orm": "^0.36.4"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "@vitest/coverage-v8": "^4.1.4",
    "typescript": "^5.7.2",
    "vitest": "^4.1.4"
  }
}
