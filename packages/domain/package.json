{
  "name": "@repo/domain",
  "version": "0.1.0",
  "private": true,
  "description": "Pure business logic - state transitions, entities, domain rules (no IO)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc --build",
