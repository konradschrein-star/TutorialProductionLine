{
  "name": "@repo/queue",
  "version": "0.1.0",
  "private": true,
  "description": "Queue infrastructure - BullMQ queue names, configuration, typed dispatch helpers",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
