{
  "name": "@repo/remotion-subtitles",
  "version": "1.0.0",
  "private": true,
  "description": "Remotion-based animated subtitle rendering with SubMagic-style captions",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
