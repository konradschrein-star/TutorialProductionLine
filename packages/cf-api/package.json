{
  "name": "@repo/cf-api",
  "version": "0.1.0",
  "private": true,
  "description": "Content Forge API core — pure server functions for jobs, drama, channels, formats. Single source of truth consumed by hub-web HTTP routes and cf-mcp-server.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./jobs": {
      "types": "./dist/jobs/index.d.ts",
      "default": "./dist/jobs/index.js"
    },
    "./drama": {
      "types": "./dist/drama/index.d.ts",
      "default": "./dist/drama/index.js"
    },
    "./formats": {
      "types": "./dist/formats/index.d.ts",
      "default": "./dist/formats/index.js"
    }
  },
  "scripts": {
    "build": "tsc --build",
    "dev": "tsc --build --watch",
    "lint": "echo 'cf-api lint not yet implemented'",
    "test": "vitest run --passWithNoTests",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@repo/config": "workspace:*",
    "@repo/contracts": "workspace:*",
    "@repo/db": "workspace:*",
    "@repo/domain": "workspace:*",
    "@repo/queue": "workspace:*",
    "drizzle-orm": "^0.36.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "@vitest/coverage-v8": "^4.1.4",
    "typescript": "^5.7.2",
    "vitest": "^4.1.4"
  }
}
