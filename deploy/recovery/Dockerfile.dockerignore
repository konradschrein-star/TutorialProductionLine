**
# Re-open parent directories, then exclude their immediate children before
# selecting files/subtrees. A bare directory negation also admits unlisted files
# such as old incremental caches and local deployment configurations.
!package.json
!.npmrc
!pnpm-lock.yaml
!pnpm-workspace.yaml
!turbo.json
!tsconfig.base.json
!apps/
apps/*
!apps/hub-web/
apps/hub-web/*
