!apps/hub-web/tsconfig.json
!apps/hub-web/next.config.js
!apps/hub-web/next-env.d.ts
!apps/hub-web/postcss.config.*
!apps/hub-web/tailwind.config.*
!apps/hub-web/src/
!apps/hub-web/src/**
!apps/hub-web/public/
!apps/hub-web/public/**
!apps/worker-orchestrator/
apps/worker-orchestrator/*
!apps/worker-orchestrator/package.json
!apps/worker-orchestrator/tsconfig.json
!apps/worker-orchestrator/src/
!apps/worker-orchestrator/src/**
!packages/
packages/*
!packages/*/
packages/*/*
!packages/*/package.json
!packages/*/tsconfig*.json
!packages/*/src/
!packages/*/src/**
!packages/*/assets/
!packages/*/assets/**
!packages/*/templates/
!packages/*/templates/**
!packages/*/fonts/
!packages/*/fonts/**
