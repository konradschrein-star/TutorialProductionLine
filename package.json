{
  "name": "youtube-automation-engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Modular 24/7 procedural YouTube content automation engine",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --concurrency=20",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "clean": "turbo run clean && rimraf node_modules",
    "infra:up": "docker compose -f infra/docker-compose.yml up -d",
    "infra:down": "docker compose -f infra/docker-compose.yml down",
    "infra:logs": "docker compose -f infra/docker-compose.yml logs -f",
    "db:migrate": "pnpm --filter @repo/db db:migrate",
    "db:studio": "pnpm --filter @repo/db db:studio",
    "seed": "tsx scripts/seed-first-run.ts",
    "start:orchestrator": "node apps/worker-orchestrator/dist/index.js",
    "test:create-job": "tsx scripts/create-test-job.ts"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.0.4",
    "playwright": "^1.48.0",
    "prettier": "^3.8.3",
    "rimraf": "^6.0.1",
    "tsx": "^4.21.0",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  },
  "pnpm": {
    "overrides": {
      "drizzle-orm": "0.36.4",
      "@types/react": "~18.3.0",
      "@types/node": "^25.5.0"
    }
  },
  "dependencies": {
    "dotenv": "^17.0.0",
    "postgres": "^3.4.5"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,md,yml,yaml}": [
      "prettier --write --ignore-unknown"
    ]
  }
}
