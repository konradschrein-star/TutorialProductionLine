# pnpm configuration for monorepo

# Disable automatic peer dependency installation
# This prevents pnpm from automatically installing peer dependencies
# that might conflict across packages (e.g., React 18 vs React 19)
auto-install-peers=false

# Don't fail on peer dependency warnings
# Worker-render uses React 18 (Remotion requirement)
# Hub-web uses React 19 (intentional)
strict-peer-dependencies=false

# Hoist dependencies to root node_modules when possible
# This helps ensure single versions of shared dependencies
shamefully-hoist=false
